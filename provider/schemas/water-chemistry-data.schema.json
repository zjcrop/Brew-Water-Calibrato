{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zjcrop/Brew-Water-Calibrato/main/provider/schemas/water-chemistry-data.schema.json",
  "title": "Brew Water chemistry dataset",
  "type": "object",
  "required": ["contract", "dataVersion", "sourceAppVersion", "solutes", "ionMolarMasses", "profiles", "scientificBoundaries"],
  "properties": {
    "contract": {"const": "water-chemistry-data/1.0"},
    "dataVersion": {"type": "string"},
    "sourceAppVersion": {"type": "string"},
    "solutes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "mw", "purity"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "mw": {"type": "number", "exclusiveMinimum": 0},
          "purity": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "cation": {"type": ["string", "null"]},
          "anion": {"type": ["string", "null"]},
          "catN": {"type": "number", "exclusiveMinimum": 0},
          "anN": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "ionMolarMasses": {"type": "object", "additionalProperties": {"type": "number", "exclusiveMinimum": 0}},
    "profiles": {"type": "object"},
    "scientificBoundaries": {"type": "object", "required": ["tds", "pH", "precipitation"]}
  }
}
